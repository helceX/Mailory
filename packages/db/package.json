{
  "name": "@mailory/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=.env.local src/migrate.ts",
    "platform-admin": "tsx --env-file-if-exists=.env.local src/platform-admin.ts"
  },
  "dependencies": {
    "@mailory/config": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "@mailory/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
