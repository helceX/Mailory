# Copy to .env (never commit). Generate SESSION_SECRET once with: openssl rand -hex 32  — do not change it later.
APP_DOMAIN=mailory.io
APP_URL=https://mailory.io
SESSION_SECRET=
# RDS example: postgres://mailory:PASSWORD@mailory-db.xxxx.eu-central-1.rds.amazonaws.com:5432/mailory?sslmode=require
DATABASE_URL=
# Only with `--profile with-db`:
DB_PASSWORD=

EMAIL_PROVIDER=ses
AWS_REGION=eu-central-1
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
EMAIL_FROM=

# Optional
AI_PROVIDER=
ANTHROPIC_API_KEY=
SENTRY_DSN=
