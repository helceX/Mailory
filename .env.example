# Copy to apps/web/.env.local, apps/worker/.env.local, packages/db/.env.local. Never commit real values.
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-64-char-random-hex-value
DATABASE_URL=postgres://mailory:mailory@localhost:5432/mailory
REDIS_URL=redis://localhost:6379
# console = write to email_outbox / logs; ses = Amazon SES
EMAIL_PROVIDER=console
EMAIL_FROM="Mailory <no-reply@mailory.io>"
AWS_REGION=eu-west-1
SES_CONFIGURATION_SET=
SENTRY_DSN=
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LOCALE=tr
# --- production extras (set in Railway; see docs/MAILORY_RUNBOOK.md) ---
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:mailory-ses-events
# SEND_RATE_PER_SECOND=14
# DOMAIN_PROVIDER=ses
# AI_PROVIDER=none            # anthropic + ANTHROPIC_API_KEY to enable the assistant
# AI_DAILY_LIMIT_PER_ORG=50
