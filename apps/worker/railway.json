{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "apps/worker/Dockerfile" },
  "deploy": {
    "preDeployCommand": [
      "apps/worker/node_modules/.bin/tsx",
      "packages/db/src/migrate.ts"
    ],
    "restartPolicyType": "ALWAYS"
  }
}
